# Environment variables for spring-petclinic — NEW RELIC ONLY mode
#
# This app sends telemetry ONLY to New Relic via the NR Java agent.
# The OTel Collector, ClickHouse, MongoDB and HyperDX containers in
# docker-compose.yml are kept running for testing / comparison purposes,
# but the application does NOT attach the OTel Java agent.
#
# Start the app:
#   java -javaagent:newrelic/newrelic.jar -jar target/*.jar
#
# Windows PowerShell:
#   Get-Content otel-configs/env/spring-petclinic-nr-only.env |
#     Where-Object { $_ -notmatch '^#' -and $_ -ne '' } |
#     ForEach-Object { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k, $v, "Process") }

NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_LICENSE_KEY_HERE
NEW_RELIC_EXPERIMENTAL_RUNTIME=false
