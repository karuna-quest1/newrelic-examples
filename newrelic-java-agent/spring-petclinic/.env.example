# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit real secrets.
#
# This file is for LOCAL DEVELOPMENT / docker-compose only.
# In Kubernetes, set these variables directly in k8s/petclinic.yml and use
# K8s Secrets for credentials. The in-cluster OTLP endpoint is:
#   http://otel-collector.monitoring.svc.cluster.local:4318

# -----------------------------------------------------------------------
# New Relic Ingest License Key
# Find or create one at: https://one.newrelic.com > (Your name) > API Keys
# Key type must be "Ingest - License"
# US accounts: collector exports to otlp.nr-data.net:4317 (if dual-writing to NR)
# EU accounts: change endpoint in otel-collector-config.yaml to
#              otlp.eu01.nr-data.net:4317
# -----------------------------------------------------------------------
NEW_RELIC_LICENSE_KEY=your_newrelic_ingest_license_key_here

# -----------------------------------------------------------------------
# OTel Java agent environment variables
# These are read by the OTel Java agent at startup to route telemetry to
# the local OTel Collector (which forwards to ClickHouse/ClickStack).
# -----------------------------------------------------------------------
OTEL_SERVICE_NAME=spring-petclinic
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.language=java
