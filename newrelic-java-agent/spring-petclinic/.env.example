# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit real secrets.

# -----------------------------------------------------------------------
# New Relic Ingest License Key
# Find or create one at: https://one.newrelic.com > (Your name) > API Keys
# Key type must be "Ingest - License"
# US accounts:  used with endpoint otlp.nr-data.net:4317
# EU accounts:  change the endpoint in otel-collector-config.yaml to
#               otlp.eu01.nr-data.net:4317
# -----------------------------------------------------------------------
NEW_RELIC_LICENSE_KEY=your_newrelic_ingest_license_key_here
